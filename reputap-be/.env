# Server
APP_PORT=8081
APP_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5433
DB_NAME=reputap
DB_USER=reputap
DB_PASSWORD=secret
DB_SSLMODE=disable

# JWT
JWT_SECRET=your-256-bit-secret-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# App
APP_BASE_URL=http://localhost:8081
REDIRECT_BASE_URL=http://localhost:8081/r

# File Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760
